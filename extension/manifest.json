{
  "action": {
    "default_popup": "popup.html",
    "default_title": "Web File Launcher"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": "",
  "version": "2.3.0",
  "name": "Web File Launcher",
  "permissions": [
    "storage",
    "nativeMessaging",
    "webNavigation",
    "activeTab"
  ],
  "background": {
    "type": "module",
    "service_worker": "background.js"
  },
  "description": "Open a locally configured file or folder when you visit a website. Windows native host required.",
  "manifest_version": 3,
  "author": "qu4nh"
}
